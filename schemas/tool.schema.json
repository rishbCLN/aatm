{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aatm.local/schemas/tool.schema.json",
  "title": "AATM Tool Definition",
  "type": "object",
  "required": ["name"],
  "additionalProperties": true,
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "parameters_schema": {"type": "object"},
    "returns_schema": {"type": "object"},
    "side_effect_scope": {
      "type": "string",
      "enum": ["none", "local", "internal", "external"]
    },
    "reversibility": {
      "type": "string",
      "enum": ["fully_reversible", "compensatable", "irreversible", "unknown"]
    },
    "idempotent": {"type": "boolean"},
    "idempotency_mode": {"type": "string", "enum": ["native", "wrapper", "none"]},
    "timeout_ms": {"type": "integer", "minimum": 1},
    "risk_level": {"type": "string", "enum": ["low", "medium", "high", "critical"]},
    "compensation_contract": {"type": ["object", "null"]},
    "postcondition_contract": {"type": ["object", "null"]}
  }
}
